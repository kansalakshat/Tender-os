# Postgres connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tenders

# Compliance rule #5: we identify honestly. Connectors REFUSE TO RUN until this is
# set to a real, monitored address -- the placeholder below is rejected in code.
CONTACT_EMAIL=you@example.com

# Free key from https://data.gov.in (register -> "My Account" -> API key).
# The data.gov.in connector refuses to run without it.
DATA_GOV_IN_API_KEY=

# Scheduler interval per connector, in hours.
SCHEDULE_INTERVAL_HOURS=6

# Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset and a random per-process secret is used instead, which means every
# restart signs everyone out.
SESSION_SECRET=

# Origin used to build verification links and the Google OAuth redirect URI.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Outbound email for address verification. Leave SMTP_HOST blank and messages are
# appended to outbox.log instead of being sent -- the signup flow still works and
# the link in the file is a real, valid one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google sign-in. Both must be set or the button is hidden entirely.
#   1. console.cloud.google.com -> APIs & Services -> Credentials
#   2. Create OAuth client ID -> Web application
#   3. Authorised redirect URI must be EXACTLY:
#        http://127.0.0.1:8000/auth/google/callback
#      (or PUBLIC_BASE_URL + /auth/google/callback in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Expired tenders are PERMANENTLY DELETED this many days after their deadline, by
# a daily scheduler job and by `tenders purge`. 0 = delete once the deadline has
# passed. A closed tender cannot be re-fetched, and buyers extend deadlines by
# corrigendum after the original date, so raise this to keep a cushion.
RETENTION_DAYS=0
