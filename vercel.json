{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/cron/ingest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/cron/purge",
      "schedule": "0 2 * * *"
    }
  ]
}
